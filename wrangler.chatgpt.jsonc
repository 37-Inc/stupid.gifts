{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stupid-gifts-chatgpt",
  "main": "prototypes/chatgpt/worker.mjs",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": false,
  "observability": { "enabled": false },
  "routes": [],
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "build": { "command": "npm --prefix prototypes/chatgpt run build" },
  "vars": {
    "MCP_PUBLIC_ORIGIN": "https://stupid.gifts",
    "PUBLIC_CATALOG_APPROVED": "false",
    "APPROVED_GIFTS": "[]"
  }
}
